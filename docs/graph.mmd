---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	retrieve(retrieve)
	grade(grade)
	rewrite(rewrite)
	generate(generate)
	check_grounding(check_grounding)
	escalate(escalate)
	finalize(finalize)
	__end__([<p>__end__</p>]):::last
	__start__ --> retrieve;
	check_grounding -.-> escalate;
	check_grounding -.-> finalize;
	generate --> check_grounding;
	grade -.-> escalate;
	grade -.-> generate;
	grade -.-> rewrite;
	retrieve --> grade;
	rewrite --> retrieve;
	escalate --> __end__;
	finalize --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc

